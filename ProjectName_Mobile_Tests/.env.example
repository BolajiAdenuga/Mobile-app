# Copy this file to .env and fill in real values. Never commit the real .env file.

# ---------------------------------------------------------------------------
# APP_SOURCE controls how the app under test gets onto the device/simulator.
#   "file"      -> Appium installs the binary found at ANDROID_APP_PATH / IOS_APP_PATH
#                  (use this for a build your own CI/CD pipeline produced,
#                  e.g. `./gradlew assembleDebug` or `xcodebuild -sdk iphonesimulator`)
#   "installed" -> Appium attaches to a build that a human already installed on a
#                  REAL device via the TestFlight app (iOS) or the Firebase App
#                  Tester app (Android). No binary is uploaded or reinstalled;
#                  Appium just launches it by package/bundle id.
# See README.md "App under test strategy" for when to use which.
# ---------------------------------------------------------------------------
APP_SOURCE=file

# --- Android -----------------------------------------------------------------
ANDROID_APP_PATH=./apps/app-debug.apk
ANDROID_APP_PACKAGE=com.sanofi.yourapp
ANDROID_APP_ACTIVITY=com.sanofi.yourapp.MainActivity
ANDROID_DEVICE_NAME=Pixel_7_API_34
ANDROID_PLATFORM_VERSION=14.0

# --- iOS -----------------------------------------------------------------
# Note: only a .app bundle (built for the simulator target) can run on a local
# simulator. A real .ipa only works on a physical device or on BrowserStack.
IOS_APP_PATH=./apps/YourApp.app
IOS_BUNDLE_ID=com.sanofi.yourapp
IOS_DEVICE_NAME=iPhone 15
IOS_PLATFORM_VERSION=17.5

# --- Appium server (local/CI) ------------------------------------------------
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723

# --- BrowserStack App Automate -------------------------------------------------
# Get these from https://app-automate.browserstack.com/dashboard -> Account settings.
# Minutes are limited on our plan: only use these configs for pre-release
# regression, never for everyday/local runs (use *.local / *.ci configs for that).
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
# Populated by `npm run upload:browserstack:android` / `:ios` (see scripts/upload-to-browserstack.ts)
BROWSERSTACK_ANDROID_APP_ID=
BROWSERSTACK_IOS_APP_ID=
# BrowserStack's real-device catalog names (see https://www.browserstack.com/list-of-browsers-and-platforms/app_automate)
BROWSERSTACK_ANDROID_DEVICE=Google Pixel 8
BROWSERSTACK_ANDROID_OS_VERSION=14.0
BROWSERSTACK_IOS_DEVICE=iPhone 15
BROWSERSTACK_IOS_OS_VERSION=17
