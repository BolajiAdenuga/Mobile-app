{
  "name": "mobile-tests-project-template",
  "version": "1.0.0",
  "description": "Cross-platform (iOS + Android) mobile test automation framework using WebdriverIO + Appium.",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "appium:setup": "appium driver install uiautomator2 && appium driver install xcuitest",
    "appium:doctor:android": "appium-doctor --android",
    "appium:doctor:ios": "appium-doctor --ios",
    "test:android:local": "wdio run ./wdio.conf/wdio.android.local.conf.ts",
    "test:android:ci": "wdio run ./wdio.conf/wdio.android.ci.conf.ts",
    "test:android:browserstack": "wdio run ./wdio.conf/wdio.android.browserstack.conf.ts",
    "test:ios:local": "wdio run ./wdio.conf/wdio.ios.local.conf.ts",
    "test:ios:ci": "wdio run ./wdio.conf/wdio.ios.ci.conf.ts",
    "test:ios:browserstack": "wdio run ./wdio.conf/wdio.ios.browserstack.conf.ts",
    "upload:browserstack:android": "tsx scripts/upload-to-browserstack.ts android",
    "upload:browserstack:ios": "tsx scripts/upload-to-browserstack.ts ios",
    "report:generate": "allure generate ./reports/allure-results --clean -o ./reports/allure-report",
    "report:open": "allure open ./reports/allure-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint e2e scripts wdio.conf --ext .ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@wdio/allure-reporter": "^9.33.1",
    "@wdio/appium-service": "^9.33.1",
    "@wdio/browserstack-service": "^9.43.0",
    "@wdio/cli": "^9.33.1",
    "@wdio/local-runner": "^9.33.1",
    "@wdio/mocha-framework": "^9.33.1",
    "@wdio/spec-reporter": "^9.33.1",
    "@wdio/types": "^9.33.1",
    "allure-commandline": "^2.46.1",
    "appium": "^2.19.0",
    "appium-doctor": "^1.16.2",
    "axios": "^1.7.9",
    "eslint": "^9.39.5",
    "form-data": "^4.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@wdio/globals": "^9.33.1",
    "dotenv": "^16.4.7",
    "webdriverio": "^9.33.1"
  }
}
